# ==========================================
# CONFIGURACIÓN DEL MÓDULO DE REPORTES LLM
# ==========================================

# -- Credenciales (¡NO COMPARTIR!) --
MAIN_PROVIDER_API_KEY=tu_api_key_de_openrouter_aqui
FALLBACK_PROVIDER_API_KEY=tu_api_key_de_groq_aqui

# -- Enrutamiento de Proveedores --
LLM_PROVIDER_PRIMARIO=openrouter
MAIN_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

LLM_PROVIDER_FALLBACK=groq
FALLBACK_PROVIDER_BASE_URL=https://api.groq.com/openai/v1

# -- Rotación de Modelos (Formato JSON estricto) --
# Modelos gratuitos sugeridos en OpenRouter: Nemotron 3 Ultra, Gemma 2, o el router automático free
LLM_MODELOS_PRIMARIO=["nvidia/nemotron-3-ultra:free", "google/gemma-2-27b-it:free", "openrouter/free"]
# Modelos sugeridos en Groq: Llama 3 70b, Gemma 2
LLM_MODELOS_FALLBACK=["llama-3.3-70b-versatile", "gemma2-9b-it"]

# -- Parámetros de Generación --
LLM_TEMPERATURA=0.3
LLM_MAX_TOKENS=2000

# -- Contexto Base del Agente --
LLM_PROMPT_BASE="Eres un analista experto en planificación académica. Genera un reporte JSON estructurado analizando las métricas y anomalías del horario."
